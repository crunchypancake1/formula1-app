{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "formula1-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public"
  },

  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // https:// scheme included — jwtVerify's `issuer` check needs it, unlike
    // auth's bare ACCESS_TEAM_DOMAIN (used there as a redirect-URI prefix).
    "ACCESS_TEAM_DOMAIN": "https://crunchypancake.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "329cad2e90546ed7e51fb3adf058b1ceb72e4f62f0d75f22e0b264a5712d8e50"
  },

  // Same namespace as bot/wrangler.jsonc's BOT_STATE — read-only here, for the
  // guild-member snapshot bot's cron tick writes (bot/src/discord/memberStore.ts).
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "f95fefa1c9e245daaa8ed60a9230579b"
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ded8933c250e438cac3a2d76b2f97b5e",
      "localConnectionString": "postgresql://postgres:changeme@localhost:7005/f1_app"
    }
  ],

  "routes": [{ "pattern": "f1.crunchypancake.com", "custom_domain": true }],

  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
