{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "formula1-bot",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,

  "triggers": {
    // Second entry is the hourly team-role reconciliation branch in
    // `src/index.ts`'s `scheduled()` — everything else runs every minute.
    "crons": ["* * * * *", "0 * * * *"]
  },

  "vars": {
    "DISCORD_GUILD_ID": "1301861026844643409",
    "DISCORD_CHANNEL_NAME": "active-session",
    "DISCORD_PUBLIC_KEY": "0a73727fe37a0143ce907f6fc2eef628c5b173255a87e898979705b9554dd7a3"
  },

  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "f95fefa1c9e245daaa8ed60a9230579b"
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ded8933c250e438cac3a2d76b2f97b5e",
      "localConnectionString": "postgresql://postgres:changeme@localhost:7005/f1_app"
    }
  ],

  "secrets_store_secrets": [
    {
      "binding": "DISCORD_BOT_TOKEN",
      "store_id": "d947ac5bb8ef4800ac46fc59128a1a09",
      "secret_name": "discord-bot-token"
    }
  ],

  // The trailing `*` matters: without it only `/bot` itself matches.
  "routes": [
    { "pattern": "f1.crunchypancake.com/bot*", "zone_name": "crunchypancake.com" }
  ],

  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
